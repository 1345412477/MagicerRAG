# ===== 推理模型（LLM） =====
# 例：DeepSeek（base=https://api.deepseek.com, model=deepseek-chat）
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ===== Embedding（向量化） =====
# 注意：DeepSeek 无 Embedding 接口，需单独配一家支持向量化的服务商。
# 例：千问 DashScope（base=https://dashscope.aliyuncs.com/compatible-mode/v1, model=text-embedding-v3）
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ===== 数据存储 =====
# 本地持久化目录（Chroma 零配置向量库）
VECTOR_DIR=./storage/vectordb
# 知识文档目录（把待索引的 PDF/MD/TXT 放这里）
DOCS_DIR=./docs

# ===== 检索参数 =====
TOP_K=4
SCORE_THRESHOLD=0.3

# ===== 网页工作台（服务端） =====
# 监听地址与端口（默认 0.0.0.0:8000）
HOST=0.0.0.0
PORT=8000
# 注册邀请码：成员注册时需填写
INVITE_CODE=magicer-demo
# 超级管理员用户名：该账号注册/登录自动提权，可管理全部用户与任意团队知识库
ADMIN_USERNAME=admin
# 数据目录：SQLite 数据库 + 上传的知识文档
DATA_DIR=./data

# ===== 图片 OCR（可选） =====
# 仅当 tesseract 不在系统 PATH 或位于非常规目录时设置；留空则自动探测常见位置
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# ===== 安全（v0.5） =====
# 模型 API Key 落库加密密钥。留空则从 EMBEDDING_API_KEY 推导（开箱即用）。
# 生产环境务必设置独立、高熵、固定的值——否则加密强度取决于 EMBEDDING_API_KEY/内置兜底；
# 一旦改动，需先解密存量 Key 再以新密钥重写。
SECRET_KEY=
# 是否信任反代注入的 X-Forwarded-For（限流取客户端 IP）。默认 0=不信任：
# 直连部署用真实 peer IP，可防伪造头绕过限流。仅当确实部署在可信 Nginx/Caddy 之后时置 1，
# 且要求反代覆盖/剥离客户端伪造值。
TRUST_PROXY_HEADERS=0
